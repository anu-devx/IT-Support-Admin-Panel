# Copy to .env (deployed values) and .env.local (local overrides).
PORT=5000                       # local only — never put PORT in the deployed .env
NODE_ENV=development            # local only
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_SSL=false              # true for hosted Postgres
PG_POOL_MAX=10

USER_PANEL_URL=http://localhost:5174
ADMIN_PANEL_URL=http://localhost:5175
BACKEND_URL=http://localhost:5174          # public base where /api is reachable
FRONTEND_ORIGINS=http://localhost:5174,http://localhost:5175   # CORS, only for cross-origin API use
COOKIE_SAME_SITE=lax            # use "none" only if the API is on a different domain than the panels
SSE_MAX_SECONDS=0               # 50 on Firebase
AUTH_RATE_LIMIT=30              # login/sign-up/reset attempts per IP per 15 min

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD="gmail app password"
MAIL_FROM="IT Support Portal <you@gmail.com>"   # optional — defaults to SMTP_USER
ADMIN_NOTIFICATION_EMAIL=you@gmail.com
SKIP_EMAIL_VERIFICATION=false   # dev only
